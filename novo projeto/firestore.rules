rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function aprovado() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // Cada pessoa só pode ver o próprio cadastro e só pode se cadastrar como "pending".
    // Ninguém consegue se aprovar pelo site: a aprovação é feita por você no painel do Firebase.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // Sugestões da comunidade: membros aprovados enviam como "pending".
    // Para aparecer no site, troque o status para "approved" no painel do Firebase.
    match /sugestoes/{id} {
      allow read: if aprovado();
      allow create: if aprovado()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() <= 500;
      allow update, delete: if false;
    }
  }
}
